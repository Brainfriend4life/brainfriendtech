generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                       String               @id @default(cuid())
  fullName                 String
  email                    String               @unique
  phone                    String               @unique
  password                 String
  walletBalance            Float                @default(0)
  role                     Role                 @default(USER)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  resetPasswordExpires     DateTime?
  resetPasswordToken       String?
  status                   UserStatus           @default(ACTIVE)
  emailVerificationExpires DateTime?
  emailVerificationToken   String?              @unique
  emailVerified            Boolean              @default(false)
  phoneVerificationCode    String?
  phoneVerificationExpires DateTime?
  phoneVerified            Boolean              @default(false)
  referralCode             String?              @unique
  referredById             String?
  referralBalance          Float                @default(0)
  cbtAttempts              CbtAttempt[]
  examPins                 ExamPin[]
  ninVerifications         NinVerification[]
  receivedReferralEarnings ReferralEarning[]    @relation("ReferredUserEarnings")
  referralEarnings         ReferralEarning[]    @relation("ReferrerEarnings")
  referralWithdrawals      ReferralWithdrawal[]
  transactions             Transaction[]
  referredBy               User?                @relation("UserReferrals", fields: [referredById], references: [id])
  referredUsers            User[]               @relation("UserReferrals")
  withdrawals              Withdrawal[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@index([referralCode])
  @@index([referredById])
}

model ReferralEarning {
  id                String          @id @default(cuid())
  referrerId        String
  referredUserId    String
  transactionId     String?
  amount            Float
  percentage        Float
  transactionAmount Float
  type              TransactionType
  status            String          @default("SUCCESS")
  description       String
  reference         String          @unique
  createdAt         DateTime        @default(now())
  referredUser      User            @relation("ReferredUserEarnings", fields: [referredUserId], references: [id], onDelete: Cascade)
  referrer          User            @relation("ReferrerEarnings", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([referredUserId])
  @@index([transactionId])
  @@index([type])
  @@index([createdAt])
}

model ReferralWithdrawal {
  id        String   @id @default(cuid())
  userId    String
  amount    Decimal  @db.Decimal(12, 2)
  status    String   @default("PENDING")
  reference String   @unique
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Float
  description String
  status      String
  reference   String          @unique
  createdAt   DateTime        @default(now())
  provider    String
  cost        Float           @default(0)
  profit      Float           @default(0)
  isTest      Boolean         @default(false)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model Withdrawal {
  id            String           @id @default(cuid())
  userId        String
  amount        Float
  accountName   String
  accountNumber String
  bankName      String
  status        WithdrawalStatus @default(PENDING)
  reference     String           @unique
  adminNote     String?
  processedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model BusinessWithdrawal {
  id                String                   @id @default(cuid())
  amount            Float
  accountName       String
  accountNumber     String
  bankName          String
  recipientCode     String?
  transferCode      String?
  reference         String                   @unique
  status            BusinessWithdrawalStatus @default(PENDING)
  adminNote         String?
  processedAt       DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  method            BusinessWithdrawalMethod @default(MANUAL)
  paystackReference String?                  @unique

  @@index([status])
  @@index([createdAt])
  @@index([method])
  @@index([paystackReference])
}

model BusinessWallet {
  id              String            @id @default(cuid())
  name            String            @unique @default("Brainfriend Global Tech")
  totalRevenue    Float             @default(0)
  totalCost       Float             @default(0)
  totalProfit     Float             @default(0)
  withdrawnProfit Float             @default(0)
  availableProfit Float             @default(0)
  balance         Float             @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  recipientCode   String?
  revenues        BusinessRevenue[]
}

model BusinessRevenue {
  id               String          @id @default(cuid())
  transactionId    String          @unique
  type             TransactionType
  provider         String
  amount           Float
  cost             Float
  profit           Float
  reference        String          @unique
  description      String?
  createdAt        DateTime        @default(now())
  businessWalletId String
  businessWallet   BusinessWallet  @relation(fields: [businessWalletId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([provider])
  @@index([createdAt])
  @@index([businessWalletId])
}

model CheapDataHubWallet {
  id          String    @id @default(cuid())
  provider    String    @unique @default("CheapDataHub")
  balance     Float     @default(0)
  lastChecked DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ExamPin {
  id        String   @id @default(cuid())
  userId    String
  provider  String
  pin       String
  serial    String
  amount    Float
  reference String   @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

model CbtAnswer {
  id             String      @id @default(cuid())
  attemptId      String
  questionId     String
  selectedAnswer String?
  isCorrect      Boolean     @default(false)
  marksAwarded   Int         @default(0)
  createdAt      DateTime    @default(now())
  attempt        CbtAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       CbtQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

model CbtAttempt {
  id          String      @id @default(cuid())
  userId      String
  examId      String
  status      String      @default("pending")
  score       Int         @default(0)
  totalMarks  Int         @default(0)
  percentage  Float       @default(0)
  startedAt   DateTime    @default(now())
  completedAt DateTime?
  answers     CbtAnswer[]
  exam        CbtExam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([status])
  @@index([userId])
}

model CbtExam {
  id          String       @id @default(cuid())
  name        String
  description String?
  duration    Int
  totalMarks  Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  attempts    CbtAttempt[]
  subjects    CbtSubject[]
}

model CbtQuestion {
  id            String      @id @default(cuid())
  question      String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  explanation   String?
  marks         Int         @default(1)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  subjectId     String
  answers       CbtAnswer[]
  subject       CbtSubject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
}

model CbtSubject {
  id          String        @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  examId      String
  questions   CbtQuestion[]
  exam        CbtExam       @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@unique([examId, name])
  @@index([examId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model DataPlan {
  id            String   @id @default(cuid())
  provider      String
  bundleId      Int      @unique
  name          String
  size          String
  duration      String
  providerPrice Float
  sellingPrice  Float
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([provider])
  @@index([status])
  @@index([provider, status])
}

model CablePlan {
  id            String   @id @default(cuid())
  planId        Int      @unique
  provider      String
  name          String
  providerPrice Float
  sellingPrice  Float
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([provider])
  @@index([status])
}

model ElectricityProvider {
  id         String   @id @default(cuid())
  providerId Int      @unique
  code       String?
  name       String
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model NinVerification {
  id            String   @id @default(cuid())
  userId        String
  nin           String
  cardType      String
  amount        Float
  reference     String   @unique
  transactionId String?  @unique
  status        String   @default("SUCCESS")
  firstName     String?
  middleName    String?
  surname       String?
  gender        String?
  birthDate     String?
  telephone     String?
  photo         String?
  hasPdf        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  pdfBase64     String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([nin])
  @@index([reference])
  @@index([createdAt])
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model BusinessRevenue_backup_old {
  id               String?
  transactionId    String?
  type             TransactionType?
  provider         String?
  amount           Float?
  cost             Float?
  profit           Float?
  reference        String?
  description      String?
  createdAt        DateTime?
  businessWalletId String?

  @@ignore
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model BusinessWallet_backup_old {
  id              String?
  name            String?
  totalRevenue    Float?
  totalCost       Float?
  totalProfit     Float?
  withdrawnProfit Float?
  availableProfit Float?
  balance         Float?
  createdAt       DateTime?
  updatedAt       DateTime?
  recipientCode   String?

  @@ignore
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum TransactionType {
  FUND_WALLET
  AIRTIME
  DATA
  ELECTRICITY
  CABLE
  EXAM_PIN
  WITHDRAWAL
  NIN
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum BusinessWithdrawalStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum BusinessWithdrawalMethod {
  MANUAL
  PAYSTACK
}
