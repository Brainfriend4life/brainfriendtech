generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =========================================================
// USER
// =========================================================

model User {
  id            String     @id @default(cuid())
  fullName      String
  email         String     @unique
  phone         String     @unique
  password      String
  walletBalance Float      @default(0)
  role          Role       @default(USER)
  status        UserStatus @default(ACTIVE)

  // EMAIL VERIFICATION
  emailVerified            Boolean   @default(false)
  emailVerificationToken   String?   @unique
  emailVerificationExpires DateTime?

  // PASSWORD RESET
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  withdrawals  Withdrawal[]
  examPins     ExamPin[]
  cbtAttempts  CbtAttempt[]
}

// =========================================================
// TRANSACTIONS
// =========================================================

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  amount      Float
  description String
  status      String
  reference   String          @unique
  createdAt   DateTime        @default(now())
  provider    String

  cost   Float @default(0)
  profit Float @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
}

// =========================================================
// CUSTOMER WITHDRAWALS
// =========================================================

model Withdrawal {
  id     String @id @default(cuid())
  userId String

  amount Float

  accountName   String
  accountNumber String
  bankName      String

  status WithdrawalStatus @default(PENDING)

  reference String  @unique
  adminNote String?

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// =========================================================
// BUSINESS / ADMIN WITHDRAWALS
// =========================================================

model BusinessWithdrawal {
  id String @id @default(cuid())

  amount Float

  method BusinessWithdrawalMethod @default(MANUAL)

  accountName   String
  accountNumber String
  bankName      String

  recipientCode String?
  transferCode  String?

  reference String @unique

  status BusinessWithdrawalStatus @default(PENDING)

  adminNote String?

  processedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([method])
  @@index([createdAt])
}

// =========================================================
// EXAM PINS
// =========================================================

model ExamPin {
  id     String @id @default(cuid())
  userId String

  provider  String
  pin       String
  serial    String
  amount    Float
  reference String   @unique
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// =========================================================
// PASSWORD RESET TOKEN
// =========================================================

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

// =========================================================
// CBT EXAM
// =========================================================

model CbtExam {
  id          String  @id @default(cuid())
  name        String
  description String?
  duration    Int
  totalMarks  Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjects CbtSubject[]
  attempts CbtAttempt[]
}

// =========================================================
// CBT SUBJECT
// =========================================================

model CbtSubject {
  id          String  @id @default(cuid())
  name        String
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  examId String

  exam CbtExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  questions CbtQuestion[]

  @@unique([examId, name])
  @@index([examId])
}

// =========================================================
// CBT QUESTION
// =========================================================

model CbtQuestion {
  id       String @id @default(cuid())
  question String

  optionA String
  optionB String
  optionC String
  optionD String

  correctAnswer String
  explanation   String?

  marks    Int     @default(1)
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subjectId String

  subject CbtSubject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  answers CbtAnswer[]

  @@index([subjectId])
}

// =========================================================
// CBT ATTEMPT
// =========================================================

model CbtAttempt {
  id String @id @default(cuid())

  userId String
  examId String

  status String @default("pending")

  score      Int   @default(0)
  totalMarks Int   @default(0)
  percentage Float @default(0)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  exam CbtExam @relation(fields: [examId], references: [id], onDelete: Cascade)

  answers CbtAnswer[]

  @@index([userId])
  @@index([examId])
  @@index([status])
}

// =========================================================
// CBT ANSWER
// =========================================================

model CbtAnswer {
  id String @id @default(cuid())

  attemptId  String
  questionId String

  selectedAnswer String?

  isCorrect    Boolean @default(false)
  marksAwarded Int     @default(0)

  createdAt DateTime @default(now())

  attempt  CbtAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question CbtQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@index([questionId])
}

// =========================================================
// ENUMS
// =========================================================

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

enum BusinessWithdrawalMethod {
  MANUAL
  PAYSTACK
}

enum BusinessWithdrawalStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  REVERSED
}

enum TransactionType {
  FUND_WALLET
  WITHDRAWAL
  AIRTIME
  DATA
  ELECTRICITY
  CABLE
  EXAM_PIN
}

enum Role {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}
